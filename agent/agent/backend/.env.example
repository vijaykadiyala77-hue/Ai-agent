# ── AI Model ─────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change model (gemini-3.5-flash is fast & cheap; gemini-3.1-pro-preview for higher quality)
AI_MODEL=gemini-3.5-flash

# ── GitHub ────────────────────────────────────────────────────────────────────
# Create a Personal Access Token at: https://github.com/settings/tokens
# Scopes needed: repo (read + write)
GITHUB_TOKEN=your_github_personal_access_token_here

# Your GitHub username and repository name
GITHUB_OWNER=vijaykadiyala77-hue
GITHUB_REPO=n8n-coding-agent

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
